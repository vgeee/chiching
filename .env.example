# Local Postgres (default for this repo's dev environment):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chiching?schema=public"

# To move to Supabase later: create a free project at supabase.com, copy the
# "Connection string" (URI, use the pooled "Transaction" mode one for serverless
# deployments) from Project Settings -> Database, and paste it here.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chiching?schema=public"

# Shared secret the /api/import/webhook route requires in the X-Import-Secret
# header. Generate a long random value and put the same one in the Google
# Apps Script that POSTs to this endpoint. Required in production — the
# webhook refuses all requests if this is unset.
INGEST_SECRET="generate-a-long-random-value"
